<devicedata>
	<copyright>Copyright 2026 DirectorLink</copyright>
	<creator>DirectorLink</creator>
	<manufacturer>Hikvision</manufacturer>
	<name>DirectorLink · Hikvision Camera</name>
	<model>Network Camera / NVR Channel</model>
	<created>10/03/2026 00:00</created>
	<!-- tools/build.py stamps modified and version from the VERSION file (major*10000 + minor*100 + patch) -->
	<modified>10/03/2026 00:00</modified>
	<version>0</version>
	<small image_source="c4z">icons/device_sm.png</small>
	<large image_source="c4z">icons/device_lg.png</large>
	<control>lua_gen</control>
	<controlmethod>ip</controlmethod>
	<driver>DriverWorks</driver>
	<composer_categories>
		<category>Cameras</category>
	</composer_categories>
	<!-- Never change or remove proxies, connection ids or event ids in later versions:
	     Control4 projects that already use the driver depend on them. -->
	<proxies qty="1">
		<proxy proxybindingid="5001" name="Camera" primary="True" image_source="c4z" small_image="icons/device_sm.png" large_image="icons/device_lg.png">camera</proxy>
	</proxies>

	<capabilities>
		<modes>SNAPSHOT, H264, H264I</modes>
		<has_pan>false</has_pan>
		<has_tilt>false</has_tilt>
		<has_zoom>false</has_zoom>
		<has_home>false</has_home>
		<has_pan_scan>false</has_pan_scan>
		<has_tilt_scan>false</has_tilt_scan>
		<has_night_mode>false</has_night_mode>
		<number_presets>0</number_presets>
		<default_http_port>80</default_http_port>
		<default_rtsp_port>554</default_rtsp_port>
		<default_authentication_required>true</default_authentication_required>
		<default_authentication_type>DIGEST</default_authentication_type>
		<default_username>admin</default_username>
		<default_password></default_password>
		<default_aspect_ratio>16x9</default_aspect_ratio>
		<address_readonly>false</address_readonly>
		<http_port_readonly>false</http_port_readonly>
		<show_test_url>true</show_test_url>
		<use_http_for_h264>false</use_http_for_h264>
		<has_extras>true</has_extras>
	</capabilities>

	<notification_attachment_provider>true</notification_attachment_provider>
	<notification_attachments>
		<attachment>
			<id>1001</id>
			<type>IMAGE_JPEG</type>
			<description>Snapshot at the last alert</description>
			<source>MEMORY</source>
		</attachment>
		<attachment>
			<id>1002</id>
			<type>IMAGE_JPEG</type>
			<description>Live snapshot</description>
			<source>URL</source>
		</attachment>
	</notification_attachments>

	<events>
		<event><id>1</id><name>Alert</name><description>When NAME raises an alert (alerts on, matches Alert On)</description></event>
		<event><id>2</id><name>Motion Detected</name><description>When NAME detects motion</description></event>
		<event><id>3</id><name>Motion Ended</name><description>When motion ends on NAME</description></event>
		<event><id>4</id><name>Person Detected</name><description>When NAME detects a person</description></event>
		<event><id>5</id><name>Vehicle Detected</name><description>When NAME detects a vehicle</description></event>
		<event><id>6</id><name>Line Crossing</name><description>When NAME detects a line crossing</description></event>
		<event><id>7</id><name>Intrusion Detected</name><description>When NAME detects an intrusion</description></event>
		<event><id>8</id><name>Region Entrance</name><description>When NAME detects a region entrance</description></event>
		<event><id>9</id><name>Region Exiting</name><description>When NAME detects a region exit</description></event>
		<event><id>10</id><name>Tamper Detected</name><description>When NAME is tampered with or covered</description></event>
		<event><id>11</id><name>Scene Change Detected</name><description>When NAME detects a scene change</description></event>
		<event><id>12</id><name>Face Detected</name><description>When NAME detects a face</description></event>
		<event><id>13</id><name>Object Left Behind</name><description>When NAME detects an unattended object</description></event>
		<event><id>14</id><name>Object Removed</name><description>When NAME detects a removed object</description></event>
		<event><id>15</id><name>Alarm Input Active</name><description>When an alarm input on NAME becomes active</description></event>
		<event><id>16</id><name>Alarm Input Inactive</name><description>When an alarm input on NAME becomes inactive</description></event>
		<event><id>17</id><name>PIR Alarm</name><description>When the PIR sensor on NAME triggers</description></event>
		<event><id>18</id><name>Camera Online</name><description>When NAME comes online</description></event>
		<event><id>19</id><name>Camera Offline</name><description>When NAME goes offline</description></event>
		<event><id>20</id><name>Alerts On</name><description>When alerts turn on for NAME</description></event>
		<event><id>21</id><name>Alerts Off</name><description>When alerts turn off or are snoozed for NAME</description></event>
	</events>

	<conditionals>
		<conditional>
			<id>1</id><name>CAMERA_ONLINE</name><type>BOOL</type>
			<condition_statement>Camera is</condition_statement><description>NAME camera is STRING</description>
			<true_text>Online</true_text><false_text>Offline</false_text>
		</conditional>
		<conditional>
			<id>2</id><name>ALERTS_ENABLED</name><type>BOOL</type>
			<condition_statement>Alerts are</condition_statement><description>NAME alerts are STRING</description>
			<true_text>On</true_text><false_text>Off</false_text>
		</conditional>
		<conditional>
			<id>3</id><name>ALERT_ACTIVE</name><type>BOOL</type>
			<condition_statement>Alert is</condition_statement><description>NAME alert is STRING</description>
			<true_text>Active</true_text><false_text>Clear</false_text>
		</conditional>
		<conditional>
			<id>4</id><name>MOTION_ACTIVE</name><type>BOOL</type>
			<condition_statement>Motion is</condition_statement><description>NAME motion is STRING</description>
			<true_text>Active</true_text><false_text>Idle</false_text>
		</conditional>
		<conditional>
			<id>5</id><name>DETECTION_ACTIVE</name><type>LIST</type>
			<condition_statement>Active detection</condition_statement><description>NAME active detection LOGIC STRING</description>
			<items>
				<item>Motion</item><item>Person</item><item>Vehicle</item><item>Line Crossing</item>
				<item>Intrusion</item><item>Tamper</item><item>Alarm Input</item>
			</items>
		</conditional>
		<conditional>
			<id>6</id><name>LAST_ALERT</name><type>LIST</type>
			<condition_statement>Last alert</condition_statement><description>NAME last alert LOGIC STRING</description>
			<items>
				<item>Motion</item><item>Person</item><item>Vehicle</item><item>Line Crossing</item><item>Intrusion</item>
				<item>Region Entrance</item><item>Region Exiting</item><item>Tamper</item><item>Scene Change</item>
				<item>Face</item><item>Object Left</item><item>Object Removed</item><item>Alarm Input</item><item>PIR</item>
				<item>Animal</item><item>Package</item><item>License Plate</item>
			</items>
		</conditional>
	</conditionals>

	<config>
		<identify_text>Enter the camera's Address, Username and Password on its Properties page, or add all cameras at once with the DirectorLink · Hikvision driver (Hikvision Hub).</identify_text>
		<script file="driver.lua" jit="1"/>
		<documentation file="www/documentation.html"/>

		<properties>
			<property><name>Connection Section</name><type>LABEL</type><default>Connection</default></property>
			<property>
				<name>Camera Enabled</name><type>LIST</type><readonly>false</readonly><default>Yes</default>
				<items><item>Yes</item><item>No</item></items>
				<tooltip>No: the driver leaves this camera alone (no events, alerts or health checks) and the hub ignores it. Use it for a camera that is off or removed.</tooltip>
			</property>
			<property>
				<name>Channel</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>128</maximum><default>1</default><readonly>false</readonly>
				<tooltip>1 for a camera. The camera's channel number when connected through an NVR. Address, ports and login are on the camera's Properties page.</tooltip>
			</property>

			<property><name>Status Section</name><type>LABEL</type><default>Status</default></property>
			<property><name>Status</name><type>STRING</type><readonly>true</readonly><default>Starting...</default></property>
			<property><name>Attention</name><type>STRING</type><readonly>true</readonly><default></default></property>
			<property><name>Camera</name><type>STRING</type><readonly>true</readonly><default></default></property>
			<property><name>Video</name><type>STRING</type><readonly>true</readonly><default></default></property>
			<property>
				<name>Events</name><type>STRING</type><readonly>true</readonly><default></default>
				<tooltip>Detections that send events to Control4 ("Notify Surveillance Center" is ticked on the camera).</tooltip>
			</property>
			<property><name>Managed By</name><type>STRING</type><readonly>true</readonly><default></default></property>
			<property><name>Driver Version</name><type>STRING</type><readonly>true</readonly><default></default></property>

			<property><name>Alerts Section</name><type>LABEL</type><default>Alerts</default></property>
			<property>
				<name>Alerts</name><type>LIST</type><readonly>false</readonly><default>On</default>
				<items><item>On</item><item>Off</item></items>
				<tooltip>When off, detections still run automations but the Alert event, notifications and history are paused.</tooltip>
			</property>
			<property>
				<name>Alert On</name><type>LIST</type><readonly>false</readonly><default>Any detection</default>
				<items><item>Any detection</item><item>People and vehicles</item><item>People only</item></items>
				<tooltip>Which detections raise an alert. People/vehicle filtering needs an AcuSense (human/vehicle) camera.</tooltip>
			</property>
			<property>
				<name>Hold Time (s)</name><type>RANGED_INTEGER</type><minimum>2</minimum><maximum>600</maximum><default>10</default><readonly>false</readonly>
				<tooltip>How long a detection or alert stays active after the camera's last report.</tooltip>
			</property>
			<property>
				<name>Snapshot With Alerts</name><type>LIST</type><readonly>false</readonly><default>Yes</default>
				<items><item>Yes</item><item>No</item></items>
				<tooltip>Take a snapshot when an alert starts, for the "Snapshot at the last alert" notification attachment.</tooltip>
			</property>
			<property>
				<name>Record Alerts In History</name><type>LIST</type><readonly>false</readonly><default>Yes</default>
				<items><item>Yes</item><item>No</item></items>
			</property>

			<property><name>Video Section</name><type>LABEL</type><default>Video</default></property>
			<property>
				<name>Video Quality</name><type>LIST</type><readonly>false</readonly><default>Auto</default>
				<items><item>Auto</item><item>High</item><item>Low</item></items>
				<tooltip>Auto picks the H.264 stream that fits each screen; High always uses the main stream; Low the sub stream. Control4 cannot play H.265.</tooltip>
			</property>
			<property>
				<name>Event Monitoring</name><type>LIST</type><readonly>false</readonly><default>On</default>
				<items><item>On</item><item>Off</item></items>
			</property>

			<property><name>Advanced Section</name><type>LABEL</type><default>Advanced</default></property>
			<property>
				<name>Contact State When Active</name><type>LIST</type><readonly>false</readonly><default>Closed</default>
				<items><item>Closed</item><item>Opened</item></items>
			</property>
			<property><name>PTZ Speed</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>100</maximum><default>50</default><readonly>false</readonly></property>
			<property>
				<name>Log Level</name><type>LIST</type><readonly>false</readonly><default>Warnings</default>
				<items><item>Off</item><item>Errors</item><item>Warnings</item><item>Info</item><item>Debug</item><item>Trace</item></items>
			</property>
		</properties>

		<actions>
			<action><name>Reconnect</name><command>Reconnect</command></action>
			<action><name>Test Snapshot</name><command>TestSnapshot</command></action>
			<action><name>Set Sub Stream To H.264</name><command>SubStreamH264</command></action>
			<action><name>Setup Report</name><command>Report</command></action>
			<action><name>Reboot Camera</name><command>Reboot</command></action>
		</actions>

		<commands>
			<command>
				<name>SET_ALERTS</name><description>Set alerts on NAME to PARAM1</description>
				<params><param><name>State</name><type>LIST</type><items><item>On</item><item>Off</item><item>Toggle</item></items></param></params>
			</command>
			<command>
				<name>SNOOZE_ALERTS</name><description>Snooze alerts on NAME for PARAM1 minutes</description>
				<params><param><name>Minutes</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>1440</maximum></param></params>
			</command>
			<command>
				<name>SET_ALERT_ON</name><description>Alert on PARAM1 for NAME</description>
				<params><param><name>Alert On</name><type>LIST</type><items><item>Any detection</item><item>People and vehicles</item><item>People only</item></items></param></params>
			</command>
			<command>
				<name>SET_MOTION_DETECTION</name><description>Set motion detection on NAME to PARAM1</description>
				<params><param><name>State</name><type>LIST</type><items><item>On</item><item>Off</item></items></param></params>
			</command>
			<command>
				<name>SET_DAY_NIGHT</name><description>Set day/night on NAME to PARAM1</description>
				<params><param><name>Mode</name><type>LIST</type><items><item>Auto</item><item>Day</item><item>Night</item></items></param></params>
			</command>
			<command>
				<name>SET_LIGHT_MODE</name><description>Set the light on NAME to PARAM1</description>
				<params><param><name>Mode</name><type>LIST</type><items><item>Smart</item><item>IR</item><item>White Light</item><item>Off</item></items></param></params>
			</command>
			<command>
				<name>SET_IMAGE</name><description>Set PARAM1 on NAME to PARAM2</description>
				<params>
					<param><name>Setting</name><type>LIST</type><items><item>Brightness</item><item>Contrast</item><item>Saturation</item><item>Sharpness</item></items></param>
					<param><name>Value</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>100</maximum></param>
				</params>
			</command>
			<command>
				<name>SET_ALARM_OUTPUT</name><description>Set alarm output PARAM1 on NAME to PARAM2 (pulse PARAM3 s)</description>
				<params>
					<param><name>Output</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>8</maximum></param>
					<param><name>State</name><type>LIST</type><items><item>On</item><item>Off</item><item>Pulse</item></items></param>
					<param><name>Pulse Seconds</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>600</maximum></param>
				</params>
			</command>
			<command>
				<name>GOTO_PRESET</name><description>Move NAME to preset PARAM1</description>
				<params><param><name>Preset</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>300</maximum></param></params>
			</command>
			<command><name>REBOOT_CAMERA</name><description>Reboot NAME</description></command>
		</commands>
	</config>

	<connections>
		<connection>
			<id>5001</id><facing>6</facing><connectionname>Camera</connectionname><type>2</type>
			<consumer>False</consumer><audiosource>False</audiosource><videosource>False</videosource><linelevel>False</linelevel>
			<classes><class><classname>CAMERA</classname></class></classes>
			<hidden>true</hidden>
		</connection>
		<connection><id>100</id><facing>6</facing><connectionname>Alert</connectionname><type>1</type><consumer>False</consumer><audiosource>False</audiosource><videosource>False</videosource><linelevel>False</linelevel><classes><class><classname>CONTACT_SENSOR</classname></class></classes></connection>
		<connection><id>101</id><facing>6</facing><connectionname>Motion</connectionname><type>1</type><consumer>False</consumer><audiosource>False</audiosource><videosource>False</videosource><linelevel>False</linelevel><classes><class><classname>CONTACT_SENSOR</classname></class></classes></connection>
		<connection><id>102</id><facing>6</facing><connectionname>Person</connectionname><type>1</type><consumer>False</consumer><audiosource>False</audiosource><videosource>False</videosource><linelevel>False</linelevel><classes><class><classname>CONTACT_SENSOR</classname></class></classes></connection>
		<connection><id>103</id><facing>6</facing><connectionname>Vehicle</connectionname><type>1</type><consumer>False</consumer><audiosource>False</audiosource><videosource>False</videosource><linelevel>False</linelevel><classes><class><classname>CONTACT_SENSOR</classname></class></classes></connection>
