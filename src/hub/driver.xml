			</property>
			<property>
				<name>Ignored Cameras</name><type>STRING</type><readonly>false</readonly><default></default>
				<tooltip>Comma-separated cameras that Add New Cameras skips: a camera IP (also skips its NVR channel), an NVR IP followed by /channel (192.168.50.10/3) for one NVR channel, or an NVR IP alone for all its channels.</tooltip>
			</property>

